# Django Settings
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=your-secret-key-here-generate-a-strong-one
DEBUG=False

# Database
DATABASE_URL=postgresql://user:password@host:5432/database_name

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=your-backend-domain.com,your-custom-domain.com

# CORS Settings (comma-separated origins)
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com,https://your-custom-domain.com

# Groq API
GROQ_API_KEY=your-groq-api-key-here

# Authentication / Email verification
ACCOUNT_EMAIL_VERIFICATION=optional
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Email (if using)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# Optional - Superuser credentials
DJANGO_SUPERUSER_EMAIL=admin@chikitsa.com
DJANGO_SUPERUSER_PASSWORD=admin123
