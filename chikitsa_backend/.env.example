# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-your-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite for development)
DATABASE_URL=sqlite:///db.sqlite3

# For PostgreSQL in production, use:
# DATABASE_URL=postgres://user:password@localhost:5432/chikitsa_db

# Chatbot Configuration (Groq API)
CHATBOT_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your-groq-api-key-here

# Doctor Verification
REQUIRE_DOCTOR_VERIFICATION=false

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Email (using console backend for development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Chikitsa <noreply@chikitsa.com>

# Logging
DJANGO_LOG_LEVEL=DEBUG
