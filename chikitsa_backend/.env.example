# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-your-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite for development)
DATABASE_URL=sqlite:///db.sqlite3

# For PostgreSQL in production, use:
# DATABASE_URL=postgres://user:password@localhost:5432/chikitsa_db

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# OpenAI / LangChain
OPENAI_API_KEY=your-openai-api-key-here
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=

# Chatbot Configuration
CHATBOT_MODEL=gpt-4-turbo-preview

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Email (using console backend for development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Chikitsa <noreply@chikitsa.com>

# Logging
DJANGO_LOG_LEVEL=DEBUG
